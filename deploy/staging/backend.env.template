# Backend environment for the TaskFlow STAGING site.
#
# deploy-staging.sh renders this ONCE to backend/.env on the server, replacing
# each __GEN_*__ value with a fresh random secret. It never overwrites an
# existing .env, so secrets survive redeploys. Nothing here is shared with
# production — WHATSAPP_ENCRYPTION_KEY above all.

NODE_ENV=production
PORT=__API_PORT__
# Loopback only; nginx is the sole way in.
HOST=127.0.0.1

TASKFLOW_DB_PATH=/var/lib/taskflow-staging/taskflow.db
# true = demo data. deploy-staging.sh sets false when run with --from-production.
SEED_ON_EMPTY=__SEED_ON_EMPTY__
ALLOW_SEED_RESET=false

ALLOWED_ORIGINS=https://__STAGING_DOMAIN__
PUBLIC_BASE_URL=https://__STAGING_DOMAIN__/api
APP_PUBLIC_URL=http://127.0.0.1:__WEB_PORT__

# ── Outbound channels: deliberately dead ────────────────────────────
# Staging may hold a copy of real data, and the reminder, overdue-invoice and
# digest sweeps run on timers. With no Resend key, every email send is skipped.
RESEND_API_KEY=
# A key that differs from production makes every stored WhatsApp token fail to
# decrypt, so staging can neither message customers nor repoint production's
# webhook at itself.
WHATSAPP_ENCRYPTION_KEY=__GEN_WHATSAPP_KEY__

# ── Authorization ───────────────────────────────────────────────────
# Staging exists to exercise the new engine, so OpenFGA decides here.
AUTHZ_ENGINE=openfga
FGA_API_URL=http://127.0.0.1:__FGA_HTTP_PORT__
FGA_API_TOKEN=__GEN_FGA_TOKEN__
# Written by deploy-staging.sh once it has bootstrapped the store.
FGA_STORE_ID=
FGA_MODEL_ID=
