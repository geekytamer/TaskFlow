# Frontend environment for the TaskFlow STAGING site.
# deploy-staging.sh renders this to frontend/.env.production before `next build`.
# NEXT_PUBLIC_* values are baked into the bundle, so a change needs a rebuild.

# Same-origin API behind nginx, exactly as production does it.
NEXT_PUBLIC_API_BASE_URL=https://__STAGING_DOMAIN__/api

# Shows the staging banner, so nobody mistakes this site for production.
NEXT_PUBLIC_APP_ENV=staging
