# TaskFlow STAGING — rendered by deploy/staging/deploy-staging.sh to
# /etc/nginx/sites-available/__STAGING_DOMAIN__. Change the template and
# redeploy rather than editing it on the server.
#
# Access model. The whole site sits behind HTTP basic auth. The API cannot use
# basic auth itself: the app already sends "Authorization: Bearer" on every
# call, which nginx would read as a failed login. So passing the basic-auth
# prompt on a page sets a gate cookie, and /api/ refuses anything without it.
# Nothing on this host answers a stranger — including the API's login route,
# which matters because staging may hold demo accounts with known passwords.
#
# The gate is a plain comparison rather than a `map`: a 64-character key
# overflows nginx's default map_hash_bucket_size, and raising that is an
# http-wide setting that would reach every other site on this server.

server {
    listen 80;
    server_name __STAGING_DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __STAGING_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__STAGING_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STAGING_DOMAIN__/privkey.pem;

    client_max_body_size 25m;

    # Production owns the WhatsApp number. Staging must never process its webhooks.
    location /api/whatsapp/webhook/ {
        return 404;
    }

    location /api/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        if ($cookie_taskflow_staging_gate != "__GATE_SECRET__") {
            return 401;
        }
        proxy_pass http://127.0.0.1:__API_PORT__/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        auth_basic           "TaskFlow staging";
        auth_basic_user_file /etc/nginx/taskflow-staging.htpasswd;
        add_header Set-Cookie "taskflow_staging_gate=__GATE_SECRET__; Path=/; Secure; HttpOnly; SameSite=Strict" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
